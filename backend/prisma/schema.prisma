generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  balance   Float    @default(10000)
  createdAt DateTime @default(now())

  orders    Order[]
  positions Position[]
}

model Market {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("open")
  expiryTime  DateTime
  resolution  String?
  engineType  String   @default("CLOB")
  createdAt   DateTime @default(now())

  orders    Order[]
  trades    Trade[]
  candles   Candle[]
  ammPool   AMMPool?
  positions Position[]   // 👈 ADD THIS
}

model Order {
  id                Int      @id @default(autoincrement())
  userId            Int
  marketId          Int
  side              String
  outcome           String   // MUST EXIST
  price             Float
  quantity          Float
  remainingQuantity Float
  status            String
  createdAt         DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
}

model Trade {
  id       Int @id @default(autoincrement())
  marketId Int

  buyerId  Int
  sellerId Int

  side      String
  price     Float
  quantity  Float
  createdAt DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id])
}

model Position {
  id       Int    @id @default(autoincrement())
  userId   Int
  marketId Int
  outcome  String
  quantity Float

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
}

model Candle {
  id        Int      @id @default(autoincrement())
  marketId  Int
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  timestamp DateTime

  market Market @relation(fields: [marketId], references: [id])
}

model AMMPool {
  id        Int     @id @default(autoincrement())
  marketId  Int     @unique
  qYes      Float   @default(0)
  qNo       Float   @default(0)
  b         Float   @default(50)

  market    Market  @relation(fields: [marketId], references: [id])
}